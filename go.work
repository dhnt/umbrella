// The dhnt umbrella workspace: one `use` per tightly coupled module, so
// every module builds against the live sibling trees. Each module's go.mod
// pins its siblings at real versions for standalone clones and CI, which
// build with GOWORK=off.
//
// Forks published under an upstream module path (sh, readline, filebrowser,
// gotreesitter, goawk, ollama, podman) are pinned in each go.mod by a
// versioned fork replace. Members may pin different fork commits, which the
// go command reports as conflicting replacements; the version-scoped
// replaces below send the required upstream version to the local tree,
// which resolves that. The toolchain line matters: in workspace mode it,
// not each go.mod, selects the toolchain.
//
// Modules outside this list (examples, prior-art fixtures, test caches)
// build standalone: run them with GOWORK=off.
go 1.27

toolchain go1.27.2

use (
	./agent-bench
	./appstore
	./bashsharp
	./bashy
	./bonsai
	./coreutils
	./coreutils/third_party/goawk
	./filebrowser
	./gfy
	./gotreesitter
	./nadir
	./outpost
	./readline
	./sh
	./ycode
	./ycode/examples/genie
	./yoke
	./yoke/external/ollama/src
	./yoke/external/otel
	./yoke/external/podman/src
	./yoke/pkg/llmgw
	./yoke/pkg/oci
	./yoke/pkg/provider
)

replace mvdan.cc/sh/v3 v3.13.1 => ./sh

replace github.com/ergochat/readline v0.1.3 => ./readline

replace github.com/filebrowser/filebrowser/v2 v2.63.23 => ./filebrowser

replace github.com/odvcencio/gotreesitter v0.16.0 => ./gotreesitter

replace github.com/benhoyt/goawk v1.31.0 => ./coreutils/third_party/goawk

replace github.com/ollama/ollama v0.0.0-00010101000000-000000000000 => ./yoke/external/ollama/src

replace go.podman.io/podman/v6 v6.0.0-20260424181651-a8c36318565d => ./yoke/external/podman/src

replace github.com/qiangli/ycode/examples/genie v0.0.0 => ./ycode/examples/genie

// yoke's nested modules (pkg/oci, pkg/llmgw, pkg/provider) are required by yoke at the zero
// version and replaced there with ./pkg/... ; a standalone consumer (outpost)
// must replace them with a published pseudo-version instead, or go list -m all
// cannot resolve the zero version. In workspace mode those two replaces
// conflict. Scoping the override to the zero version every member requires
// resolves it to the live tree and keeps working when a consumer bumps its pin.
replace github.com/qiangli/yoke/pkg/oci v0.0.0-00010101000000-000000000000 => ./yoke/pkg/oci

replace github.com/qiangli/yoke/pkg/llmgw v0.0.0-00010101000000-000000000000 => ./yoke/pkg/llmgw

replace github.com/qiangli/yoke/pkg/provider v0.0.0-00010101000000-000000000000 => ./yoke/pkg/provider

replace github.com/go-git/go-billy/v5 => ./yoke/external/go-billy

replace github.com/hashicorp/go-multierror => ./yoke/external/multierror

replace github.com/hashicorp/errwrap => ./yoke/external/errwrap

replace github.com/libp2p/go-yamux/v5 => ./yamux/v5

replace github.com/cyphar/filepath-securejoin => ./yoke/external/securejoin

replace github.com/mattn/go-runewidth => ./yoke/external/runewidth
